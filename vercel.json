{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    { "source": "/services", "destination": "/solutions", "permanent": true },
    { "source": "/portfolio", "destination": "/work", "permanent": true },
    { "source": "/portfolio/la-cafebreria", "destination": "/work", "permanent": true },
    { "source": "/portfolio/taxes-insurance-group", "destination": "/work", "permanent": true },
    { "source": "/portfolio/acaballo-equestrian-school", "destination": "/work", "permanent": true },
    { "source": "/google-ads/ai-business-os", "destination": "/solutions/automation-ai", "permanent": true },
    { "source": "/pages/google-ads/ai-business-os", "destination": "/solutions/automation-ai", "permanent": true },
    { "source": "/qualifier", "destination": "/contact", "permanent": true },
    { "source": "/qualifier.html", "destination": "/contact", "permanent": true },
    { "source": "/pages/:path*", "destination": "/:path*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://www.ruutdev.com" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PATCH,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,Authorization" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://api.web3forms.com https://*.supabase.co; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://buy.stripe.com;" }
      ]
    }
  ]
}
